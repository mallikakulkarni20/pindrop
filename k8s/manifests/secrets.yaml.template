# Secrets template (do not commit real values)
# Copy to `secrets.yaml` and replace placeholders with base64-encoded values.

apiVersion: v1
kind: Secret
metadata:
  name: pindrop-secrets
  namespace: pindrop
  labels:
    app: pindrop
# Default secret type for key/value pairs
type: Opaque
data:
  # Supabase
  SUPABASE_URL: <BASE64_ENCODED_VALUE>
  SUPABASE_SERVICE_ROLE_KEY: <BASE64_ENCODED_VALUE>

  # JWT
  JWT_SECRET: <BASE64_ENCODED_VALUE>
  JWT_REFRESH_SECRET: <BASE64_ENCODED_VALUE>

  # OpenAI
  OPENAI_API_KEY: <BASE64_ENCODED_VALUE>
  OPENAI_MODEL: Z3B0LTMuNS10dXJibw==

  # Google OAuth
  GOOGLE_CLIENT_ID: <BASE64_ENCODED_VALUE>
  GOOGLE_CLIENT_SECRET: <BASE64_ENCODED_VALUE>

---
# Tip: `./scripts/create-secrets.sh` creates this secret directly from `.env`.
