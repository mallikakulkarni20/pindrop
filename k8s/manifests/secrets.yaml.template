# =============================================================================
# KUBERNETES SECRETS - TEMPLATE
# =============================================================================
# IMPORTANT: This is a TEMPLATE file. Do NOT commit actual secrets to git!
#
# Secrets store sensitive data like passwords, API keys, and tokens.
# Values must be base64 encoded (Kubernetes decodes them when injecting).
#
# How to use this template:
# 1. Copy this file: cp secrets.yaml.template secrets.yaml
# 2. Replace <BASE64_ENCODED_VALUE> with your actual base64-encoded secrets
# 3. Apply: kubectl apply -f secrets.yaml -n pindrop
# 4. DO NOT commit secrets.yaml to git!
#
# How to base64 encode a value:
#   echo -n "your-secret-value" | base64
#
# Example:
#   echo -n "my-jwt-secret-key" | base64
#   Output: bXktand0LXNlY3JldC1rZXk=
#
# Why base64 and not encryption?
# - Kubernetes Secrets are NOT encrypted by default, just encoded
# - This prevents accidental exposure in logs but is NOT secure storage
# - For production, use external secret managers (Vault, AWS Secrets Manager)
# - Or use sealed-secrets, external-secrets operators
#
# Usage:
#   kubectl apply -f secrets.yaml -n pindrop
#   kubectl get secrets -n pindrop
#   kubectl describe secret pindrop-secrets -n pindrop
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: pindrop-secrets
  namespace: pindrop
  labels:
    app: pindrop
# Opaque is the default type for arbitrary user-defined data
type: Opaque
data:
  # -------------------------------------------------------------------------
  # Supabase Configuration
  # -------------------------------------------------------------------------
  # Your Supabase project URL
  # Example: echo -n "https://xxxxx.supabase.co" | base64
  SUPABASE_URL: <BASE64_ENCODED_VALUE>
  
  # Supabase service role key (has admin access - keep secure!)
  # Example: echo -n "eyJhbGciOiJIUzI1NiIsInR5cCI6..." | base64
  SUPABASE_SERVICE_ROLE_KEY: <BASE64_ENCODED_VALUE>
  
  # -------------------------------------------------------------------------
  # JWT Configuration
  # -------------------------------------------------------------------------
  # Secret key for signing JWT access tokens
  # Example: echo -n "your-super-secret-jwt-key" | base64
  JWT_SECRET: <BASE64_ENCODED_VALUE>
  
  # Secret key for signing JWT refresh tokens
  # Example: echo -n "your-super-secret-refresh-key" | base64
  JWT_REFRESH_SECRET: <BASE64_ENCODED_VALUE>
  
  # -------------------------------------------------------------------------
  # OpenAI Configuration
  # -------------------------------------------------------------------------
  # OpenAI API key for chat functionality
  # Example: echo -n "sk-..." | base64
  OPENAI_API_KEY: <BASE64_ENCODED_VALUE>
  
  # OpenAI model to use (optional, has default in code)
  # Example: echo -n "gpt-3.5-turbo" | base64
  OPENAI_MODEL: Z3B0LTMuNS10dXJibw==
  
  # -------------------------------------------------------------------------
  # Google OAuth Configuration
  # -------------------------------------------------------------------------
  # Google OAuth client ID
  # Example: echo -n "xxxxx.apps.googleusercontent.com" | base64
  GOOGLE_CLIENT_ID: <BASE64_ENCODED_VALUE>
  
  # Google OAuth client secret
  # Example: echo -n "GOCSPX-..." | base64
  GOOGLE_CLIENT_SECRET: <BASE64_ENCODED_VALUE>

---
# =============================================================================
# INSTRUCTIONS FOR CREATING YOUR secrets.yaml
# =============================================================================
# 
# Option 1: Manual base64 encoding
# ---------------------------------
# For each secret in your .env file, run:
#   echo -n "value" | base64
# 
# Then copy the output into secrets.yaml
#
# Option 2: Use the helper script (scripts/create-secrets.sh)
# -----------------------------------------------------------
# We provide a script that reads your .env file and generates secrets.yaml
# Run: ./scripts/create-secrets.sh
#
# Option 3: Create secrets directly with kubectl
# -----------------------------------------------
# kubectl create secret generic pindrop-secrets \
#   --from-literal=SUPABASE_URL=https://xxx.supabase.co \
#   --from-literal=SUPABASE_SERVICE_ROLE_KEY=eyJ... \
#   --from-literal=JWT_SECRET=your-jwt-secret \
#   --from-literal=JWT_REFRESH_SECRET=your-refresh-secret \
#   --from-literal=OPENAI_API_KEY=sk-... \
#   --from-literal=GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com \
#   --from-literal=GOOGLE_CLIENT_SECRET=GOCSPX-... \
#   -n pindrop
#
# This is easier because kubectl handles the base64 encoding for you!
# =============================================================================
